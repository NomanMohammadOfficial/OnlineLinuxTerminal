---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TerminalRunner } from '../../components/terminal/TerminalRunner';
import { LearningPanel } from '../../components/terminal/LearningPanel';
import { AdSlot } from '../../components/ads/AdSlot';

const workspaceSchema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": "Full Shell Workspace — Online Linux Terminal",
  "url": "https://onlinelinuxterminal.com/terminal/",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Linux, Web, ChromeOS, Windows, macOS",
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  },
  "description": "Full-screen interactive online linux terminal workspace. Practice bash commands, inspect virtual filesystems, and run interactive tutorials in browser."
};
---

<BaseLayout
  title="Full Shell Workspace — Free Online Linux Terminal in Browser for Practice"
  description="Interactive online linux terminal workspace. Practice bash commands, execute file operations, search with grep, test scripts with simulated root access in your web browser."
  keywords="online linux terminal, full shell workspace online linux terminal, free online linux terminal for practice, online linux terminal simulator, online linux terminal in browser, online linux terminal ubuntu, online linux terminal with root access, free online linux terminal practice"
>
  <script type="application/ld+json" set:html={JSON.stringify(workspaceSchema)} />

  <div class="max-w-[1600px] mx-auto px-3 sm:px-6 lg:px-8 py-4 sm:py-6 space-y-6">
    <!-- Top Workspace Status & Community Bar -->
    <div class="flex flex-col md:flex-row items-start md:items-center justify-between gap-3 p-3.5 sm:p-4 bg-zinc-900 border border-zinc-800 rounded-xl">
      <div class="space-y-0.5">
        <h1 class="text-base sm:text-lg font-bold font-mono text-zinc-100 flex items-center space-x-2">
          <span class="text-emerald-400">$</span>
          <span>Online Linux Terminal Workspace</span>
        </h1>
        <p class="text-[11px] sm:text-xs text-zinc-400">
          Chat with real Linux users, learn new commands & get free cheat sheet PDFs in our Telegram community.
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-2 text-xs font-mono">
        <span class="flex items-center space-x-1.5 px-2.5 py-1.5 rounded-lg bg-zinc-800 border border-zinc-700 text-emerald-400 text-[11px]">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>2.4k Online</span>
        </span>
        <a
          href="https://t.me/onlinelinuxterminal"
          target="_blank"
          rel="noopener noreferrer"
          class="relative inline-flex p-[1px] rounded-xl overflow-hidden group shadow-md shadow-emerald-950/40 hover:scale-105 active:scale-95 transition-all duration-300"
          title="Join Linux Community on Telegram"
        >
          <!-- Rotating Boundary Light Ray -->
          <span class="absolute inset-[-1000%] animate-[spin_3.5s_linear_infinite] bg-[conic-gradient(from_90deg_at_50%_50%,transparent_0%,#10b981_40%,#34d399_50%,#10b981_60%,transparent_100%)]"></span>

          <!-- Button Content Surface -->
          <span class="relative inline-flex items-center space-x-1.5 px-3.5 py-1.5 rounded-[11px] bg-gradient-to-r from-emerald-500 via-teal-400 to-emerald-500 text-zinc-950 font-bold font-sans text-xs overflow-hidden">
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" fill="currentColor" class="bi bi-telegram w-3.5 h-3.5 fill-zinc-950 shrink-0 group-hover:scale-110 transition-transform duration-200" viewBox="0 0 16 16">
              <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0M8.287 5.906q-1.168.486-4.666 2.01-.567.225-.595.442c-.03.243.275.339.69.47l.175.055c.408.133.958.288 1.243.294q.39.01.868-.32 3.269-2.206 3.374-2.23c.05-.012.12-.026.166.016s.042.12.037.141c-.03.129-1.227 1.241-1.846 1.817-.193.18-.33.307-.358.336a8 8 0 0 1-.188.186c-.38.366-.664.64.015 1.088.327.216.589.393.85.571.284.194.568.387.936.629q.14.092.27.187c.331.236.63.448.997.414.214-.02.435-.22.547-.82.265-1.417.786-4.486.906-5.751a1.4 1.4 0 0 0-.013-.315.34.34 0 0 0-.114-.217.53.53 0 0 0-.31-.093c-.3.005-.763.166-2.984 1.09"/>
            </svg>
            <span>Join Telegram</span>
          </span>
        </a>
      </div>
    </div>

    <!-- Ad Placement Top -->
    <AdSlot type="banner" client:idle />

    <!-- Workspace Main Layout: Terminal + Interactive Learning Panel -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 min-h-[500px]">
      <!-- Terminal Window -->
      <div class="lg:col-span-2 min-h-[480px] sm:min-h-[540px] flex flex-col">
        <TerminalRunner client:load className="flex-1 min-h-[480px] sm:min-h-[540px]" />
      </div>

      <!-- Learning Panel Sidebar -->
      <div class="lg:col-span-1 min-h-[380px] sm:min-h-[540px] flex flex-col">
        <LearningPanel client:load />
      </div>
    </div>

    <!-- 500+ Word SEO Guide Section -->
    <section class="mt-8 sm:mt-12 p-6 sm:p-8 bg-zinc-900/50 border border-zinc-800 rounded-2xl space-y-6 text-zinc-300">
      <h2 class="text-2xl font-bold text-zinc-100 font-sans">
        About the Online Linux Terminal Full Shell Workspace
      </h2>
      <p class="text-xs sm:text-sm leading-relaxed">
        Welcome to the premier <strong>online linux terminal for practice free</strong>. This full-screen interactive workspace is designed to give students, developers, and DevOps engineers an authentic Linux command-line environment directly inside any web browser.
      </p>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 text-xs sm:text-sm">
        <div class="space-y-2">
          <h3 class="font-bold text-emerald-400">Client-Side IndexedDB Sandbox</h3>
          <p class="text-zinc-400 leading-relaxed">
            Unlike server-dependent terminals that experience lag, our <strong>online linux terminal simulator</strong> executes all commands client-side using a JavaScript AST parser. Created files, directory modifications, and history persist in IndexedDB.
          </p>
        </div>
        <div class="space-y-2">
          <h3 class="font-bold text-emerald-400">Simulated Root Access & Utilities</h3>
          <p class="text-zinc-400 leading-relaxed">
            Test system administrative operations with an <strong>online linux terminal with root access</strong> simulation. Modify permissions via <code>chmod</code>, change ownership via <code>chown</code>, and run text filters like <code>grep</code>, <code>sed</code>, and <code>awk</code>.
          </p>
        </div>
      </div>
    </section>

    <!-- Ad Placement Bottom -->
    <AdSlot type="leaderboard" client:idle />
  </div>
</BaseLayout>
