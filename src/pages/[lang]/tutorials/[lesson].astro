---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { TerminalRunner } from '../../../components/terminal/TerminalRunner';
import { TRANSLATIONS, type SupportedLocale, getLocalizedPath } from '../../../i18n/translations';
import TelegramCta from '../../../components/community/TelegramCta.astro';

export function getStaticPaths() {
  const locales: SupportedLocale[] = ['ru', 'es', 'de', 'fr', 'zh'];
  const lessons = [
    {
      slug: 'basics',
      title: 'Linux Navigation Basics',
      level: 'Beginner',
      steps: [
        { title: 'Step 1: Check Current Directory', instruction: 'Run `pwd` to print working directory path.' },
        { title: 'Step 2: List Files in Detail', instruction: 'Run `ls -la` to inspect file permissions and size.' },
        { title: 'Step 3: Read Welcome Notes', instruction: 'Run `cat welcome.txt` to read content.' },
        { title: 'Step 4: Navigate into Projects', instruction: 'Run `cd projects` and run `ls`.' },
      ]
    },
    {
      slug: 'file-management',
      title: 'File & Directory Manipulation',
      level: 'Beginner',
      steps: [
        { title: 'Step 1: Create a Folder', instruction: 'Run `mkdir -p lab/configs` to create a directory.' },
        { title: 'Step 2: Create a File', instruction: 'Run `echo "hello linux" > lab/test.sh`.' },
        { title: 'Step 3: Verify Creation', instruction: 'Run `cat lab/test.sh` to confirm file presence.' },
      ]
    },
    {
      slug: 'grep-text-search',
      title: 'Text Searching & Regex with Grep',
      level: 'Intermediate',
      steps: [
        { title: 'Step 1: Simple Pattern Match', instruction: 'Run `grep -i "error" /var/log/syslog`.' },
        { title: 'Step 2: Line Numbering', instruction: 'Run `grep -n -i "accepted" /var/log/auth.log`.' },
        { title: 'Step 3: Invert Filter', instruction: 'Run `grep -v "^#" /etc/hosts`.' },
      ]
    },
    {
      slug: 'permissions',
      title: 'Linux Permissions & Chmod',
      level: 'Intermediate',
      steps: [
        { title: 'Step 1: Inspect Permissions', instruction: 'Run `ls -l /var/log/auth.log`.' },
        { title: 'Step 2: Update Mode Bits', instruction: 'Run `chmod 755 /home/user/projects/demo.sh`.' },
        { title: 'Step 3: Restrict File', instruction: 'Run `chmod 600 welcome.txt`.' },
      ]
    },
    {
      slug: 'pipes-redirection',
      title: 'I/O Redirection & Command Pipelines',
      level: 'Intermediate',
      steps: [
        { title: 'Step 1: Pipe into Word Count', instruction: 'Run `ls -la /var/log | wc -l`.' },
        { title: 'Step 2: Redirect Date to File', instruction: 'Run `date > timestamp.txt`.' },
        { title: 'Step 3: Append Content', instruction: 'Run `uname -a >> timestamp.txt`.' },
      ]
    },
    {
      slug: 'processes-top-kill',
      title: 'Process Management & Monitoring',
      level: 'Intermediate',
      steps: [
        { title: 'Step 1: Process Snapshot', instruction: 'Run `ps aux` to list active processes.' },
        { title: 'Step 2: Check Memory Usage', instruction: 'Run `free -h` to see memory stats.' },
      ]
    },
    {
      slug: 'tar-compression',
      title: 'Archiving & Compression with Tar',
      level: 'Intermediate',
      steps: [
        { title: 'Step 1: Create Tarball', instruction: 'Run `tar -czvf projects_backup.tar.gz /home/user/projects`.' },
        { title: 'Step 2: Test Extraction', instruction: 'Run `tar -tvf projects_backup.tar.gz`.' },
      ]
    },
    {
      slug: 'network-diagnostics',
      title: 'Network Diagnostics with Curl',
      level: 'Advanced',
      steps: [
        { title: 'Step 1: Latency Check', instruction: 'Run `ping -c 4 8.8.8.8`.' },
        { title: 'Step 2: HTTP Headers', instruction: 'Run `curl -I https://onlinelinuxterminal.com`.' },
      ]
    }
  ];

  const paths: Array<{ params: { lang: SupportedLocale; lesson: string }; props: { lessonData: typeof lessons[0] } }> = [];
  locales.forEach((l) => {
    lessons.forEach((les) => {
      paths.push({
        params: { lang: l, lesson: les.slug },
        props: { lessonData: les },
      });
    });
  });
  return paths;
}

const { lang, lesson } = Astro.params as { lang: SupportedLocale; lesson: string };
const { lessonData } = Astro.props;
const t = TRANSLATIONS[lang] || TRANSLATIONS.en;
---

<BaseLayout
  lang={lang}
  title={`${lessonData.title} — ${t.navTutorials}`}
  description={`Interactive tutorial lesson: ${lessonData.title}. Practice live in browser.`}
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="space-y-2">
      <div class="flex items-center space-x-3">
        <a href={getLocalizedPath('/tutorials/', lang)} class="text-xs font-mono text-emerald-400 hover:underline">← {t.navTutorials}</a>
        <span class="text-zinc-600">•</span>
        <span class="text-xs font-mono px-2 py-0.5 rounded bg-zinc-900 text-zinc-400 border border-zinc-800">
          {lessonData.level}
        </span>
      </div>
      <h1 class="text-3xl font-extrabold text-zinc-100 font-sans">{lessonData.title}</h1>
    </div>

    <!-- Telegram Community Box on top of Tutorial Workspace -->
    <TelegramCta lang={lang} />

    <!-- Workspace Split: Instructions & Terminal -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
      <div class="lg:col-span-1 space-y-4 bg-zinc-900 border border-zinc-800 rounded-xl p-5">
        <h2 class="font-bold text-base text-emerald-400">Lesson Objectives</h2>
        <div class="space-y-3">
          {lessonData.steps.map((s) => (
            <div class="p-3 bg-zinc-950 border border-zinc-800 rounded-lg space-y-1 text-xs">
              <div class="font-semibold text-zinc-200">{s.title}</div>
              <p class="text-zinc-400 leading-relaxed">{s.instruction}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="lg:col-span-2">
        <TerminalRunner client:load className="h-[520px]" />
      </div>
    </div>
  </div>
</BaseLayout>
