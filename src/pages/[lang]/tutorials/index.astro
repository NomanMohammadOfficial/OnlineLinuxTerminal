---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { TUTORIALS_LIST } from '../../tutorials/index.astro';
import { TRANSLATIONS, type SupportedLocale } from '../../../i18n/translations';

export function getStaticPaths() {
  const locales: SupportedLocale[] = ['ru', 'es', 'de', 'fr', 'zh'];
  return locales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = TRANSLATIONS[lang] || TRANSLATIONS.en;
---

<BaseLayout
  lang={lang}
  title={`${t.navTutorials} — ${t.heroHighlight}`}
  description={t.heroSub}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-100 font-sans">
        {t.navTutorials}
      </h1>
      <p class="text-sm text-zinc-400 leading-relaxed">{t.heroSub}</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {TUTORIALS_LIST.map((t) => (
        <a
          href={`/tutorials/${t.slug}/`}
          class="p-6 bg-zinc-900/60 border border-zinc-800 rounded-2xl hover:border-emerald-800/80 hover:bg-zinc-900 transition-all group flex flex-col justify-between space-y-4"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/50">
                {t.level}
              </span>
              <span class="text-xs font-mono text-zinc-500">{t.duration}</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-100 group-hover:text-emerald-400 transition-colors">
              {t.title}
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">{t.desc}</p>
          </div>

          <div class="pt-4 flex items-center justify-between text-xs font-mono text-emerald-400 font-semibold border-t border-zinc-800/80">
            <span>Start Guided Tutorial</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>
