---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { TRANSLATIONS, type SupportedLocale, getLocalizedPath } from '../../i18n/translations';
import TelegramCta from '../../components/community/TelegramCta.astro';

export function getStaticPaths() {
  const locales: SupportedLocale[] = ['ru', 'es', 'de', 'fr', 'zh'];
  return locales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = TRANSLATIONS[lang] || TRANSLATIONS.en;

const I18N_CONTACT_TITLES: Record<SupportedLocale, { title: string; h1: string; sub: string }> = {
  en: {
    title: "Contact & Engineering Support — Online Linux Terminal",
    h1: "Contact & Support",
    sub: "Have questions, feedback, or a feature request? Reach out to our engineering team."
  },
  ru: {
    title: "Контакты и поддержка — Онлайн Терминал Linux",
    h1: "Контакты и поддержка",
    sub: "Есть вопросы, отзывы или предложения? Свяжитесь с нашей инженерной командой."
  },
  es: {
    title: "Contacto y Soporte Técnico — Terminal Linux Online",
    h1: "Contacto y Soporte",
    sub: "¿Tiene preguntas, sugerencias o comentarios? Escriba a nuestro equipo de ingeniería."
  },
  de: {
    title: "Kontakt & Technischer Support — Online Linux Terminal",
    h1: "Kontakt & Support",
    sub: "Haben Sie Fragen, Feedback oder Vorschläge? Kontaktieren Sie unser Entwicklungsteam."
  },
  fr: {
    title: "Contact & Support Technique — Terminal Linux en Ligne",
    h1: "Contact & Support",
    sub: "Vous avez des questions, des remarques ou des suggestions ? Contactez notre équipe."
  },
  zh: {
    title: "联系我们与技术支持 — 在线 Linux 终端",
    h1: "联系与支持",
    sub: "如有任何疑问、建议或错误反馈，欢迎联系我们的工程团队。"
  }
};

const contactData = I18N_CONTACT_TITLES[lang] || I18N_CONTACT_TITLES.en;
---

<BaseLayout
  lang={lang}
  title={contactData.title}
  description={contactData.sub}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10 text-zinc-300">
    <div class="space-y-3 border-b border-zinc-800 pb-8">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-800/80 text-emerald-400 text-xs font-mono">
        <span>Support & Community</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-100 font-sans">
        {contactData.h1}
      </h1>
      <p class="text-sm text-zinc-400 max-w-2xl leading-relaxed">
        {contactData.sub}
      </p>
    </div>

    <!-- Telegram Community Box -->
    <TelegramCta lang={lang} />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Direct Contact Card -->
      <div class="p-6 bg-zinc-900/60 border border-zinc-800 rounded-2xl space-y-4">
        <h2 class="text-xl font-bold text-emerald-400 font-sans">Direct Communication</h2>
        <div class="space-y-3 text-xs font-mono">
          <div class="p-3.5 bg-zinc-950 border border-zinc-800/80 rounded-xl space-y-1">
            <span class="text-zinc-500 uppercase tracking-wider text-[10px]">Email:</span>
            <div><a href="mailto:support@onlinelinuxterminal.com" class="text-emerald-400 hover:underline font-bold">support@onlinelinuxterminal.com</a></div>
          </div>
          <div class="p-3.5 bg-zinc-950 border border-zinc-800/80 rounded-xl space-y-1">
            <span class="text-zinc-500 uppercase tracking-wider text-[10px]">GitHub:</span>
            <div><a href="https://github.com/NomanMohammadOfficial/OnlineLinuxTerminal" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:underline">github.com/NomanMohammadOfficial</a></div>
          </div>
          <div class="p-3.5 bg-zinc-950 border border-zinc-800/80 rounded-xl space-y-1">
            <span class="text-zinc-500 uppercase tracking-wider text-[10px]">Response SLA:</span>
            <div class="text-zinc-300">Within 24–48 hours on business days.</div>
          </div>
        </div>
      </div>

      <!-- Quick Links Box -->
      <div class="p-6 bg-zinc-900/60 border border-zinc-800 rounded-2xl space-y-4">
        <h2 class="text-xl font-bold text-zinc-100 font-sans">Quick Links</h2>
        <ul class="space-y-3 text-xs font-mono">
          <li><a href={getLocalizedPath('/terminal/', lang)} class="text-emerald-400 hover:underline">→ Terminal Workspace ($)</a></li>
          <li><a href={getLocalizedPath('/linux-online-compiler/', lang)} class="text-emerald-400 hover:underline">→ {t.navCompiler} ⚡</a></li>
          <li><a href={getLocalizedPath('/cheat-sheet/', lang)} class="text-emerald-400 hover:underline">→ {t.navCheatSheet} ⚡</a></li>
          <li><a href="/contact/" class="text-zinc-400 hover:text-zinc-200">→ English Master Contact Form</a></li>
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>
