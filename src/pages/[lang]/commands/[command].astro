---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { TerminalRunner } from '../../../components/terminal/TerminalRunner';
import YandexAd from '../../../components/ads/YandexAd.astro';
import { TRANSLATIONS, type SupportedLocale, getLocalizedPath } from '../../../i18n/translations';
import { COMMANDS_DATA, type LinuxCommand } from '../../../data/commandsData';
import { getLocalizedCommandData } from '../../../i18n/commandTranslations';
import TelegramCta from '../../../components/community/TelegramCta.astro';

export function getStaticPaths() {
  const locales: SupportedLocale[] = ['ru', 'es', 'de', 'fr', 'zh'];
  const paths: Array<{ params: { lang: SupportedLocale; command: string }; props: { cmdData: LinuxCommand } }> = [];

  locales.forEach((l) => {
    COMMANDS_DATA.forEach((c) => {
      paths.push({
        params: { lang: l, command: c.slug },
        props: { cmdData: c },
      });
    });
  });
  return paths;
}

const { lang, command } = Astro.params as { lang: SupportedLocale; command: string };
const { cmdData } = Astro.props;
const t = TRANSLATIONS[lang] || TRANSLATIONS.en;
const localized = getLocalizedCommandData(cmdData, lang);

const techArticleSchema = {
  "@context": "https://schema.org",
  "@type": "TechArticle",
  "headline": `${localized.name} — ${t.navCommands}`,
  "description": localized.summary,
  "articleSection": localized.category,
  "inLanguage": lang,
  "author": {
    "@type": "Organization",
    "name": "Online Linux Terminal",
    "url": "https://onlinelinuxterminal.com"
  },
  "publisher": {
    "@type": "Organization",
    "name": "Online Linux Terminal",
    "url": "https://onlinelinuxterminal.com"
  }
};

const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": t.heroHighlight,
      "item": `https://onlinelinuxterminal.com/${lang}/`
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": t.navCommands,
      "item": `https://onlinelinuxterminal.com/${lang}/commands/`
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": localized.name,
      "item": `https://onlinelinuxterminal.com/${lang}/commands/${localized.slug}/`
    }
  ]
};

const relatedCommandsList = COMMANDS_DATA.filter((c) =>
  cmdData.relatedCommands?.includes(c.slug) || (c.category === cmdData.category && c.slug !== cmdData.slug)
).slice(0, 6);
---

<BaseLayout
  lang={lang}
  title={`${localized.name} — ${localized.summary} | ${t.heroHighlight}`}
  description={`${localized.name} Linux: ${localized.summary}`}
>
  <script type="application/ld+json" set:html={JSON.stringify(techArticleSchema)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-10">
    <!-- Breadcrumbs Navigation -->
    <nav class="flex items-center space-x-2 text-xs font-mono text-zinc-400" aria-label="Breadcrumb">
      <a href={getLocalizedPath('/', lang)} class="hover:text-emerald-400 transition-colors">{t.heroHighlight}</a>
      <span>/</span>
      <a href={getLocalizedPath('/commands/', lang)} class="hover:text-emerald-400 transition-colors">{t.navCommands}</a>
      <span>/</span>
      <span class="text-zinc-200 font-semibold">{localized.name}</span>
    </nav>

    <!-- Header & Hero -->
    <div class="space-y-4">
      <div class="flex flex-wrap items-center gap-3">
        <span class="text-xs font-mono px-2.5 py-1 rounded-md bg-emerald-950/80 text-emerald-400 border border-emerald-800/80 font-medium">
          {localized.category}
        </span>
        <span class="text-xs font-mono px-2 py-0.5 rounded bg-zinc-900 text-zinc-400 border border-zinc-800">
          CLI Manual
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-100 font-mono tracking-tight flex items-center space-x-3">
        <span class="text-emerald-400">$</span>
        <span>{localized.name}</span>
      </h1>

      <p class="text-base sm:text-lg text-zinc-300 leading-relaxed max-w-3xl">
        {localized.summary}
      </p>
    </div>

    <!-- Syntax Box with Quick Copy -->
    <div class="p-5 bg-zinc-900/90 border border-zinc-800 rounded-2xl space-y-2 font-mono shadow-xl relative group">
      <div class="flex items-center justify-between text-zinc-400 text-xs font-sans">
        <span class="uppercase tracking-wider text-[11px] font-semibold text-zinc-500">{localized.labels.syntaxLabel}</span>
        <span class="text-xs text-zinc-500 font-mono">POSIX Standard</span>
      </div>
      <div class="p-3 bg-zinc-950 rounded-xl border border-zinc-800/80 text-emerald-300 text-sm font-semibold overflow-x-auto flex items-center justify-between">
        <code>{localized.syntax}</code>
        <button
          onclick={`navigator.clipboard.writeText('${localized.syntax}'); this.innerText = '${localized.labels.copiedBtn}'; setTimeout(() => this.innerText = '${localized.labels.copyBtn}', 2000)`}
          class="ml-3 px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded text-xs transition-colors shrink-0 font-sans cursor-pointer"
        >
          {localized.labels.copyBtn}
        </button>
      </div>
    </div>

    <!-- Telegram Community Box on top of Sandbox Terminal -->
    <TelegramCta lang={lang} />

    <!-- Live Interactive Sandbox Island -->
    <div class="space-y-4">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
        <div>
          <h2 class="text-xl font-bold text-zinc-100 flex items-center space-x-2">
            <span>{localized.labels.sandboxTitle}</span>
          </h2>
          <p class="text-xs text-zinc-400">{localized.labels.sandboxSubtitle}</p>
        </div>
        <a
          href={getLocalizedPath(`/terminal/?cmd=${encodeURIComponent(localized.defaultSandboxCmd)}`, lang)}
          class="inline-flex items-center space-x-1 text-xs font-mono text-emerald-400 hover:text-emerald-300 hover:underline shrink-0"
        >
          <span>{localized.labels.fullWorkspaceBtn}</span>
        </a>
      </div>

      <div class="rounded-2xl border border-zinc-800 bg-zinc-950 p-1 shadow-2xl">
        <TerminalRunner client:load initialCommand={localized.defaultSandboxCmd} className="h-[420px]" />
      </div>
    </div>

    <!-- In-article ad: below the interactive sandbox, above the long-form guide -->
    <YandexAd slot="in-article" format="horizontal" />

    <!-- Overview & In-Depth Details -->
    <div class="p-6 sm:p-8 bg-zinc-900/40 border border-zinc-800/80 rounded-2xl space-y-4 text-zinc-300 leading-relaxed text-sm sm:text-base">
      <h2 class="text-2xl font-bold text-zinc-100 font-sans">
        {localized.labels.overviewTitle}
      </h2>
      <p class="text-zinc-300 leading-relaxed">{localized.description}</p>
    </div>

    <!-- Flags & Options Table -->
    {localized.flags && localized.flags.length > 0 && (
      <div class="space-y-4">
        <h2 class="text-2xl font-bold text-zinc-100 font-sans">
          {localized.labels.flagsTitle}
        </h2>
        <div class="border border-zinc-800 rounded-2xl overflow-hidden bg-zinc-900/60 shadow-lg">
          <table class="w-full text-left text-xs sm:text-sm font-mono">
            <thead class="bg-zinc-950 text-zinc-400 border-b border-zinc-800">
              <tr>
                <th class="p-3.5 sm:p-4 w-1/4">Flag / Option</th>
                <th class="p-3.5 sm:p-4">Description</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-zinc-800/80">
              {localized.flags.map((f) => (
                <tr class="hover:bg-zinc-800/30 transition-colors">
                  <td class="p-3.5 sm:p-4 text-emerald-400 font-bold whitespace-nowrap">
                    <span class="px-2 py-1 bg-zinc-950 rounded border border-zinc-800">{f.flag}</span>
                  </td>
                  <td class="p-3.5 sm:p-4 text-zinc-300 font-sans text-xs sm:text-sm">{f.desc}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    )}

    <!-- Real-World Examples -->
    {localized.examples && localized.examples.length > 0 && (
      <div class="space-y-6">
        <h2 class="text-2xl font-bold text-zinc-100 font-sans">
          {localized.labels.examplesTitle}
        </h2>

        <div class="grid grid-cols-1 gap-5">
          {localized.examples.map((ex, index) => (
            <div class="p-5 bg-zinc-900/70 border border-zinc-800 rounded-2xl space-y-3 shadow-md">
              <div class="flex items-center justify-between">
                <span class="text-xs font-mono text-emerald-400 font-semibold">#{index + 1}</span>
                <span class="text-xs text-zinc-400 font-medium">{ex.title}</span>
              </div>

              <div class="p-3 bg-zinc-950 rounded-xl border border-zinc-800 text-emerald-300 font-mono text-xs sm:text-sm flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                <code class="overflow-x-auto">{ex.cmd}</code>
                <div class="flex items-center space-x-2 shrink-0 pt-1 sm:pt-0">
                  <button
                    onclick={`navigator.clipboard.writeText('${ex.cmd.replace(/'/g, "\\'")}'); this.innerText = '${localized.labels.copiedBtn}'; setTimeout(() => this.innerText = '${localized.labels.copyBtn}', 2000)`}
                    class="px-2.5 py-1 bg-zinc-800 hover:bg-zinc-700 text-zinc-300 rounded text-xs transition-colors cursor-pointer font-sans"
                  >
                    {localized.labels.copyBtn}
                  </button>
                  <a
                    href={getLocalizedPath(`/terminal/?cmd=${encodeURIComponent(ex.cmd)}`, lang)}
                    class="px-2.5 py-1 bg-emerald-600 hover:bg-emerald-500 text-zinc-950 font-bold rounded text-xs transition-colors flex items-center space-x-1 font-sans"
                  >
                    <span>{localized.labels.runBtn}</span>
                  </a>
                </div>
              </div>

              <p class="text-xs text-zinc-400 leading-relaxed font-sans">{ex.explanation}</p>
            </div>
          ))}
        </div>
      </div>
    )}

    <!-- Related Commands Cross-Linking Grid -->
    {relatedCommandsList.length > 0 && (
      <div class="space-y-4 pt-4 border-t border-zinc-800">
        <h2 class="text-xl font-bold text-zinc-100 font-sans">
          {localized.labels.relatedTitle}
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {relatedCommandsList.map((rel) => {
            const relLocalized = getLocalizedCommandData(rel, lang);
            return (
              <a
                href={getLocalizedPath(`/commands/${rel.slug}/`, lang)}
                class="p-4 bg-zinc-900/60 border border-zinc-800 rounded-xl hover:border-emerald-800 hover:bg-zinc-900 transition-all group block"
              >
                <div class="flex items-center justify-between mb-1">
                  <span class="font-mono font-bold text-emerald-400 group-hover:text-emerald-300">
                    ${rel.name}
                  </span>
                  <span class="text-[10px] font-mono px-1.5 py-0.5 rounded bg-zinc-800 text-zinc-400">
                    {relLocalized.category}
                  </span>
                </div>
                <p class="text-xs text-zinc-400 line-clamp-2">{relLocalized.summary}</p>
              </a>
            );
          })}
        </div>
      </div>
    )}

    <!-- Bottom ad: after all content, before the footer -->
    <YandexAd slot="bottom" format="horizontal" minHeight={90} />
  </div>
</BaseLayout>
