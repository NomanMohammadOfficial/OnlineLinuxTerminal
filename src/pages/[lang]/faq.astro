---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SeoFaq from '../../components/seo/SeoFaq.astro';
import { TRANSLATIONS, type SupportedLocale } from '../../i18n/translations';

export function getStaticPaths() {
  const locales: SupportedLocale[] = ['ru', 'es', 'de', 'fr', 'zh'];
  return locales.map((lang) => ({
    params: { lang },
  }));
}

const { lang } = Astro.params as { lang: SupportedLocale };
const t = TRANSLATIONS[lang] || TRANSLATIONS.en;
---

<BaseLayout
  lang={lang}
  title={`${t.faqHeaderTitle} — Online Linux Terminal`}
  description={t.faqHeaderSub}
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-8">
    <div class="space-y-3 border-b border-zinc-800 pb-8 text-center max-w-2xl mx-auto">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-800/80 text-emerald-400 text-xs font-mono">
        <span>Help Center & FAQ</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-100 font-sans">
        {t.faqHeaderTitle}
      </h1>
      <p class="text-sm text-zinc-400 leading-relaxed">
        {t.faqHeaderSub}
      </p>
    </div>

    <!-- Interactive FAQ Component -->
    <SeoFaq lang={lang} />
  </div>
</BaseLayout>
