---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="500 Internal Server Error — Online Linux Terminal"
  description="500 Error: An unexpected error occurred on OnlineLinuxTerminal.com."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center space-y-8">
    <div class="max-w-2xl mx-auto bg-zinc-900 border border-zinc-800 rounded-2xl p-6 sm:p-8 text-left font-mono space-y-4 shadow-2xl">
      <div class="flex items-center space-x-2 border-b border-zinc-800 pb-3">
        <div class="w-3 h-3 rounded-full bg-red-500"></div>
        <div class="w-3 h-3 rounded-full bg-amber-500"></div>
        <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
        <span class="text-xs text-zinc-500 ml-2">kernel panic — 500 error</span>
      </div>

      <div class="space-y-2 text-sm">
        <div class="text-amber-400">
          [ 0.004120] Kernel panic - not syncing: Fatal exception in AST execution engine (Error 500)
        </div>
        <div class="text-zinc-400 text-xs pt-2">
          An unexpected server or runtime error occurred while processing your request.
        </div>
      </div>
    </div>

    <div class="flex items-center justify-center gap-4">
      <a
        href="/"
        class="px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold rounded-xl text-sm transition-all shadow-lg"
      >
        Return to Homepage
      </a>
    </div>
  </div>
</BaseLayout>
