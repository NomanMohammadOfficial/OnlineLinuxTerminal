---
import BaseLayout from '../../layouts/BaseLayout.astro';
import YandexAd from '../../components/ads/YandexAd.astro';
import { CommandsDirectory } from '../../components/commands/CommandsDirectory';
import { COMMANDS_DATA, COMMAND_CATEGORIES } from '../../data/commandsData';
import TelegramCta from '../../components/community/TelegramCta.astro';

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Complete Linux Commands Manual & Sandbox Directory",
  "description": "Comprehensive reference guide for 50+ essential Linux commands with syntax rules, option flags, and live interactive testing.",
  "itemListElement": COMMANDS_DATA.map((cmd, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": cmd.name,
    "url": `https://onlinelinuxterminal.com/commands/${cmd.slug}/`
  }))
};
---

<BaseLayout
  title="Linux Command Reference Manual — 50+ Commands with Live Interactive Sandbox"
  description="Comprehensive reference guide for 50+ essential Linux commands. Learn syntax, flags, and real-world examples for find, grep, chmod, curl, ps, tar, and test live in browser."
  keywords="online linux terminal, linux command reference, best online linux terminal, online linux terminal platform, online linux terminal simulator, linux command manual, linux commands cheat sheet"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-10 sm:py-14 space-y-10">
    <!-- Header Hero -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-800/80 text-emerald-400 text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>50+ Interactive Linux Command Guides</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-100 font-sans tracking-tight">
        Linux Command Reference Manual
      </h1>
      <p class="text-sm sm:text-base text-zinc-400 leading-relaxed max-w-2xl mx-auto">
        Search and select any Linux command below to inspect syntax rules, option flags, and launch an instant client-side terminal sandbox.
      </p>
    </div>

    <!-- Telegram Community Box -->
    <TelegramCta lang="en" />

    <!-- Interactive Search & Filtering Directory Island -->
    <CommandsDirectory client:load commands={COMMANDS_DATA} categories={COMMAND_CATEGORIES} />

    <!-- In-article ad: below the interactive directory, above the SEO guide -->
    <YandexAd slot="in-article" format="horizontal" />

    <!-- 600+ Word Comprehensive SEO Knowledge Section -->
    <section class="mt-16 p-6 sm:p-10 bg-zinc-900/40 border border-zinc-800 rounded-3xl space-y-8 text-zinc-300">
      <div class="space-y-3">
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-100 font-sans">
          Why Learn Linux Commands with an Interactive In-Browser Terminal?
        </h2>
        <p class="text-xs sm:text-sm leading-relaxed text-zinc-400">
          The Linux operating system powers over 90% of the world's public cloud infrastructure, containerized Kubernetes clusters, and mission-critical production servers. Mastering Linux command-line operations is the foundational skill required for software engineering, DevOps, Cloud Architecture, and Cybersecurity.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
        <div class="p-5 bg-zinc-950/60 rounded-2xl border border-zinc-800/80 space-y-2">
          <h3 class="font-bold text-emerald-400 text-sm">Real-World Command Drills</h3>
          <p class="text-zinc-400 leading-relaxed">
            Every command manual provides authentic examples for high-traffic utilities like <code>grep</code>, <code>find</code>, <code>chmod</code>, <code>tar</code>, and <code>curl</code>.
          </p>
        </div>

        <div class="p-5 bg-zinc-950/60 rounded-2xl border border-zinc-800/80 space-y-2">
          <h3 class="font-bold text-emerald-400 text-sm">Zero-Risk Sandbox Environment</h3>
          <p class="text-zinc-400 leading-relaxed">
            Practice risky commands like <code>rm -rf</code>, privilege elevations with <code>chmod</code>, or directory restructuring with zero danger to your local machine.
          </p>
        </div>

        <div class="p-5 bg-zinc-950/60 rounded-2xl border border-zinc-800/80 space-y-2">
          <h3 class="font-bold text-emerald-400 text-sm">Deep-Link URL Execution</h3>
          <p class="text-zinc-400 leading-relaxed">
            Use the <strong>"Run in Sandbox ⚡"</strong> buttons to immediately preload and test commands in a live, persistent virtual filesystem.
          </p>
        </div>
      </div>
    </section>

    <!-- Bottom ad: after all content, before the footer -->
    <YandexAd slot="bottom" format="horizontal" minHeight={90} />
  </div>
</BaseLayout>
