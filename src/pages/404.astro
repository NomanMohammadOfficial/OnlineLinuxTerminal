---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="404 Page Not Found — Online Linux Terminal"
  description="404 Error: The requested URL or Linux path was not found on OnlineLinuxTerminal.com."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center space-y-8">
    <!-- Terminal Prompt Error Box -->
    <div class="max-w-2xl mx-auto bg-zinc-900 border border-zinc-800 rounded-2xl p-6 sm:p-8 text-left font-mono space-y-4 shadow-2xl">
      <div class="flex items-center space-x-2 border-b border-zinc-800 pb-3">
        <div class="w-3 h-3 rounded-full bg-red-500"></div>
        <div class="w-3 h-3 rounded-full bg-amber-500"></div>
        <div class="w-3 h-3 rounded-full bg-emerald-500"></div>
        <span class="text-xs text-zinc-500 ml-2">bash — 404 error</span>
      </div>

      <div class="space-y-2 text-sm">
        <div class="text-emerald-400">
          user@linux-box:~$ <span class="text-zinc-100">cd /requested-page</span>
        </div>
        <div class="text-red-400 font-semibold">
          bash: cd: /requested-page: No such file or directory (Error 404)
        </div>
        <div class="text-zinc-400 text-xs pt-2">
          The page or command reference you are looking for has been moved, renamed, or does not exist.
        </div>
      </div>
    </div>

    <!-- Quick Navigation CTAs -->
    <div class="space-y-4">
      <h2 class="text-xl font-bold text-zinc-100 font-sans">Where would you like to go?</h2>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="/terminal/"
          class="px-6 py-3 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold rounded-xl text-sm transition-all shadow-lg flex items-center space-x-2"
        >
          <span class="font-mono">$</span>
          <span>Open Terminal Workspace</span>
        </a>
        <a
          href="/commands/"
          class="px-6 py-3 bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-zinc-700 font-semibold rounded-xl text-sm transition-all"
        >
          Browse Commands Manual
        </a>
        <a
          href="/"
          class="px-6 py-3 bg-zinc-900 hover:bg-zinc-800 text-zinc-200 border border-zinc-700 font-semibold rounded-xl text-sm transition-all"
        >
          Return to Homepage
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
