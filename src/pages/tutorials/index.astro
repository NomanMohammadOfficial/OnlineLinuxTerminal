---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdSlot } from '../../components/ads/AdSlot';

export const TUTORIALS_LIST = [
  {
    slug: 'basics',
    title: 'Linux Terminal Basics & Navigation',
    level: 'Beginner',
    duration: '10 mins',
    desc: 'Learn how to inspect directories with pwd and ls, navigate absolute and relative paths with cd, and inspect text files with cat.',
  },
  {
    slug: 'file-management',
    title: 'File & Directory Manipulation',
    level: 'Beginner',
    duration: '15 mins',
    desc: 'Master creating files with touch and echo, organizing nested folders with mkdir -p, copying with cp, and removing items with rm.',
  },
  {
    slug: 'grep-text-search',
    title: 'Text Searching & Regex with Grep',
    level: 'Intermediate',
    duration: '15 mins',
    desc: 'Filter log streams and search through large files using essential grep flags (-i, -n, -v) and regex pattern matching.',
  },
  {
    slug: 'permissions',
    title: 'Linux Permissions & Chmod',
    level: 'Intermediate',
    duration: '15 mins',
    desc: 'Understand read, write, and execute permissions for user, group, and others using octal modes like 755, 644, and 600.',
  },
  {
    slug: 'pipes-redirection',
    title: 'I/O Redirection & Command Pipelines',
    level: 'Intermediate',
    duration: '15 mins',
    desc: 'Chain commands together using pipes (|), redirect standard output with >, append with >>, and filter streams with sort and uniq.',
  },
  {
    slug: 'processes-top-kill',
    title: 'Process Management & System Monitoring',
    level: 'Intermediate',
    duration: '12 mins',
    desc: 'Inspect running system processes with ps aux and top, monitor CPU and memory usage, and terminate hung tasks using kill.',
  },
  {
    slug: 'tar-compression',
    title: 'Archiving & Compression with Tar & Gzip',
    level: 'Intermediate',
    duration: '12 mins',
    desc: 'Bundle directories into tarballs with tar -czvf, list archive contents with -tvf, and decompress archives safely with tar -xzvf.',
  },
  {
    slug: 'network-diagnostics',
    title: 'Network Diagnostics with Curl & Ping',
    level: 'Advanced',
    duration: '15 mins',
    desc: 'Test network latency with ping, inspect HTTP response headers with curl -I, and verify connectivity across remote endpoints.',
  },
];

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "Interactive Linux Command Line Curriculum",
  "description": "Comprehensive step-by-step interactive Linux command line tutorials with live browser sandbox execution, automated verification, and zero setup.",
  "provider": {
    "@type": "Organization",
    "name": "Online Linux Terminal",
    "url": "https://onlinelinuxterminal.com"
  }
};
---

<BaseLayout
  title="Interactive Linux Tutorials — Free Online Linux Terminal Practice"
  description="Step-by-step interactive Linux command line tutorials. Practice terminal navigation, file management, grep filtering, permissions, pipelines, and processes live in browser."
  keywords="online linux terminal practice, free online linux terminal practice, webminal online linux terminal practice, free online linux terminal for practice, online linux terminal tutorial, learn linux command line"
>
  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-12">
    <!-- Hero Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-800/80 text-emerald-400 text-xs font-mono">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Interactive Linux Learning Track</span>
      </div>
      <h1 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-zinc-100 font-sans tracking-tight">
        Interactive Linux Command Line Tutorials
      </h1>
      <p class="text-sm sm:text-base text-zinc-400 leading-relaxed">
        Step-by-step guided lessons with instant browser terminal execution, live command validation, and zero setup required.
      </p>
    </div>

    <!-- Tutorials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-6xl mx-auto">
      {TUTORIALS_LIST.map((t, idx) => (
        <a
          href={`/tutorials/${t.slug}/`}
          class="p-6 bg-zinc-900/60 border border-zinc-800 rounded-2xl hover:border-emerald-800/80 hover:bg-zinc-900 transition-all group flex flex-col justify-between space-y-4"
        >
          <div class="space-y-3">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono px-2.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/50">
                Lesson {idx + 1} • {t.level}
              </span>
              <span class="text-xs font-mono text-zinc-500">{t.duration}</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-100 group-hover:text-emerald-400 transition-colors">
              {t.title}
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">{t.desc}</p>
          </div>

          <div class="pt-4 flex items-center justify-between text-xs font-mono text-emerald-400 font-semibold border-t border-zinc-800/80">
            <span>Start Guided Tutorial</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <!-- In-Depth SEO & Educational Guide Section -->
    <section class="max-w-5xl mx-auto p-6 sm:p-10 bg-zinc-900/40 border border-zinc-800 rounded-3xl space-y-8 text-zinc-300">
      <div class="space-y-3">
        <h2 class="text-2xl sm:text-3xl font-bold text-zinc-100 font-sans">
          Why Hands-on Interactive Terminal Drills Deliver 3x Faster Retention
        </h2>
        <p class="text-xs sm:text-sm leading-relaxed text-zinc-400">
          Learning the Linux operating system is primarily a muscle memory exercise. Reading syntax manuals without active execution leads to rapid forgetting. Our in-browser guided curriculum bridges theory and practice by providing an immediate, risk-free shell sandbox alongside every lesson.
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 text-xs sm:text-sm">
        <div class="p-5 bg-zinc-950/60 rounded-2xl border border-zinc-800/80 space-y-2">
          <h3 class="font-bold text-emerald-400 text-sm">1. Progressive Difficulty</h3>
          <p class="text-zinc-400 leading-relaxed">
            Begin with basic directory traversal (<code>pwd</code>, <code>cd</code>, <code>ls</code>), advance to stream redirection (<code>|</code>, <code>&gt;</code>), and master process orchestration.
          </p>
        </div>

        <div class="p-5 bg-zinc-950/60 rounded-2xl border border-zinc-800/80 space-y-2">
          <h3 class="font-bold text-emerald-400 text-sm">2. Instant Verification</h3>
          <p class="text-zinc-400 leading-relaxed">
            Execute commands against a live Virtual File System and observe authentic terminal stdout output in real time.
          </p>
        </div>

        <div class="p-5 bg-zinc-950/60 rounded-2xl border border-zinc-800/80 space-y-2">
          <h3 class="font-bold text-emerald-400 text-sm">3. Zero-Risk Exploration</h3>
          <p class="text-zinc-400 leading-relaxed">
            Practice destructive administrative tasks like removing folders with <code>rm -rf</code> or changing root permissions with zero risk to your physical device.
          </p>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
