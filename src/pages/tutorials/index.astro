---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdSlot } from '../../components/ads/AdSlot';

export const TUTORIALS_LIST = [
  {
    slug: 'basics',
    title: 'Linux Terminal Basics & Navigation',
    level: 'Beginner',
    duration: '10 mins',
    desc: 'Learn how to inspect directories with pwd and ls, navigate file paths with cd, and view file contents using cat.',
  },
  {
    slug: 'file-management',
    title: 'File & Directory Manipulation',
    level: 'Beginner',
    duration: '15 mins',
    desc: 'Master creating files with touch and echo, organizing folders with mkdir, copying with cp, and removing items with rm.',
  },
  {
    slug: 'grep-text-search',
    title: 'Text Searching & Regex with Grep',
    level: 'Intermediate',
    duration: '15 mins',
    desc: 'Filter logs and search large files using grep flags (-i, -n, -v) and output redirection operators.',
  },
  {
    slug: 'permissions',
    title: 'Linux Permissions & Chmod',
    level: 'Intermediate',
    duration: '15 mins',
    desc: 'Understand read, write, execute permissions for user, group, and others using octal modes like 755 and 644.',
  },
];

const courseSchema = {
  "@context": "https://schema.org",
  "@type": "Course",
  "name": "Interactive Linux Command Line Course",
  "description": "Step-by-step interactive Linux command line tutorials with instant terminal execution and automated verification.",
  "provider": {
    "@type": "Organization",
    "name": "Online Linux Terminal",
    "url": "https://onlinelinuxterminal.com"
  }
};
---

<BaseLayout
  title="Interactive Linux Tutorials — Free Online Linux Terminal Practice"
  description="Step-by-step interactive Linux command line tutorials. Practice terminal navigation, file management, text searching with grep, and permissions live in browser."
  keywords="online linux terminal practice, free online linux terminal practice, webminal online linux terminal practice, free online linux terminal for practice, online linux terminal for practice free, online linux terminal tutorial"
>
  <script type="application/ld+json" set:html={JSON.stringify(courseSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-800/80 text-emerald-400 text-xs font-mono">
        <span>Interactive Linux Learning Track</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-100 font-sans">
        Interactive Linux Command Line Tutorials
      </h1>
      <p class="text-sm text-zinc-400 leading-relaxed">
        Step-by-step guided lessons with instant browser terminal execution, live command validation, and zero setup required.
      </p>
    </div>

    <!-- Ad Placement Top -->
    <AdSlot type="banner" client:idle />

    <!-- Tutorials Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-5xl mx-auto">
      {TUTORIALS_LIST.map((t) => (
        <a
          href={`/tutorials/${t.slug}/`}
          class="p-6 bg-zinc-900/60 border border-zinc-800 rounded-2xl hover:border-emerald-800/80 hover:bg-zinc-900 transition-all group flex flex-col justify-between space-y-4"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono px-2.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/50">
                {t.level}
              </span>
              <span class="text-xs font-mono text-zinc-500">{t.duration}</span>
            </div>
            <h3 class="text-xl font-bold text-zinc-100 group-hover:text-emerald-400 transition-colors">
              {t.title}
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">{t.desc}</p>
          </div>

          <div class="pt-4 flex items-center justify-between text-xs font-mono text-emerald-400 font-semibold border-t border-zinc-800/80">
            <span>Start Guided Tutorial</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <!-- 600+ Word SEO Content Section -->
    <section class="max-w-4xl mx-auto p-6 sm:p-8 bg-zinc-900/40 border border-zinc-800 rounded-2xl space-y-6 text-zinc-300">
      <h2 class="text-2xl font-bold text-zinc-100 font-sans">
        Why Practice Linux Commands with Interactive Guided Tutorials?
      </h2>
      <p class="text-xs sm:text-sm leading-relaxed">
        Learning the Linux command-line interface requires hands-on repetition. Reading command manuals is helpful, but actual retention happens when you execute commands inside a real terminal shell. Our <strong>free online linux terminal practice</strong> tutorials combine conceptual explanations with live step-by-step terminal execution.
      </p>

      <div class="space-y-4 text-xs sm:text-sm">
        <h3 class="text-lg font-bold text-emerald-400">Structured Learning Path for Linux Beginners</h3>
        <p class="text-zinc-400 leading-relaxed">
          Traditional platforms like <strong>webminal online linux terminal practice</strong> provided command prompts, but lacked real-time automated step verification. Our tutorials walk you through essential Linux milestones:
        </p>
        <ul class="list-disc list-inside text-zinc-400 space-y-2">
          <li><strong>Navigation & Filesystem Traversal:</strong> Master <code>pwd</code>, <code>ls -l</code>, and <code>cd</code> path resolution.</li>
          <li><strong>File Creation & Manipulation:</strong> Practice redirecting output with <code>echo "text" &gt; file</code> and viewing logs with <code>cat</code>.</li>
          <li><strong>Log Analysis & Pattern Matching:</strong> Filter text streams using <code>grep -i -n</code> expressions.</li>
          <li><strong>File Security & Permissions:</strong> Understand octal mode bits with <code>chmod 755</code> and ownership with <code>chown</code>.</li>
        </ul>
      </div>
    </section>

    <!-- Ad Placement Bottom -->
    <AdSlot type="leaderboard" client:idle />
  </div>
</BaseLayout>
