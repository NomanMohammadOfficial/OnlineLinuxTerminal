---
import BaseLayout from '../layouts/BaseLayout.astro';
import TelegramCta from '../components/community/TelegramCta.astro';

const contactSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Contact & Engineering Support — Online Linux Terminal",
  "url": "https://onlinelinuxterminal.com/contact/",
  "description": "Contact the Online Linux Terminal engineering team for support, feedback, feature requests, or technical bug reports.",
  "publisher": {
    "@type": "Organization",
    "name": "Online Linux Terminal",
    "url": "https://onlinelinuxterminal.com",
    "logo": "https://onlinelinuxterminal.com/icon.svg"
  }
};
---

<BaseLayout
  title="Contact Us & Support — Online Linux Terminal"
  description="Get in touch with the Online Linux Terminal engineering team. Submit bug reports, request new Linux command guides, or ask technical support questions."
  keywords="online linux terminal contact, linux terminal support, bug report linux terminal, contact engineering team"
>
  <script type="application/ld+json" set:html={JSON.stringify(contactSchema)} />

  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10 text-zinc-300">
    <!-- Header -->
    <div class="space-y-3 border-b border-zinc-800 pb-8 text-center sm:text-left">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-800/80 text-emerald-400 text-xs font-mono">
        <span>Support & Community</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-100 font-sans">
        Contact & Support
      </h1>
      <p class="text-sm text-zinc-400 max-w-2xl leading-relaxed">
        Have questions, feedback, or a feature request for Online Linux Terminal? Our engineering team is here to help.
      </p>
    </div>

    <!-- Telegram Community Box -->
    <TelegramCta lang="en" />

    <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
      <!-- Contact Info & SLA Card -->
      <div class="space-y-6">
        <div class="p-6 bg-zinc-900/60 border border-zinc-800 rounded-2xl space-y-4">
          <h2 class="text-xl font-bold text-emerald-400 font-sans">Direct Inquiries</h2>
          <p class="text-xs text-zinc-400 leading-relaxed">
            For technical support, tutorial suggestions, partnership opportunities, or editorial corrections:
          </p>

          <div class="space-y-3 text-xs font-mono">
            <div class="p-3.5 bg-zinc-950 border border-zinc-800/80 rounded-xl space-y-1">
              <span class="text-zinc-500 uppercase tracking-wider text-[10px]">Email Support:</span>
              <div>
                <a href="mailto:support@onlinelinuxterminal.com" class="text-emerald-400 hover:underline font-bold">
                  support@onlinelinuxterminal.com
                </a>
              </div>
            </div>

            <div class="p-3.5 bg-zinc-950 border border-zinc-800/80 rounded-xl space-y-1">
              <span class="text-zinc-500 uppercase tracking-wider text-[10px]">GitHub Repository:</span>
              <div>
                <a href="https://github.com/NomanMohammadOfficial/OnlineLinuxTerminal" target="_blank" rel="noopener noreferrer" class="text-emerald-400 hover:underline">
                  github.com/NomanMohammadOfficial/OnlineLinuxTerminal
                </a>
              </div>
            </div>

            <div class="p-3.5 bg-zinc-950 border border-zinc-800/80 rounded-xl space-y-1">
              <span class="text-zinc-500 uppercase tracking-wider text-[10px]">Response SLA:</span>
              <div class="text-zinc-300">
                Typically within <span class="text-emerald-400 font-bold">24–48 hours</span> on business days.
              </div>
            </div>
          </div>
        </div>

        <!-- Quick Resources Box -->
        <div class="p-5 bg-zinc-900/40 border border-zinc-800/60 rounded-2xl space-y-2">
          <h3 class="font-bold text-zinc-200 text-sm">Need Instant Answers?</h3>
          <p class="text-xs text-zinc-400">
            Check our <a href="/faq/" class="text-emerald-400 hover:underline">Frequently Asked Questions</a> or browse our <a href="/cheat-sheet/" class="text-emerald-400 hover:underline">Ultimate Linux Cheat Sheet</a> for quick solutions.
          </p>
        </div>
      </div>

      <!-- Interactive Contact / Feedback Form -->
      <div class="p-6 bg-zinc-900/60 border border-zinc-800 rounded-2xl space-y-4">
        <h2 class="text-xl font-bold text-zinc-100 font-sans">Send Feedback or Bug Report</h2>
        
        <form id="contact-form" class="space-y-4 text-xs">
          <div>
            <label class="block text-zinc-400 mb-1 font-mono font-medium">Your Name</label>
            <input
              type="text"
              id="name-input"
              required
              placeholder="e.g., Alex Johnson"
              class="w-full px-3.5 py-2.5 bg-zinc-950 border border-zinc-800 rounded-xl text-zinc-200 focus:outline-none focus:border-emerald-500 transition-colors"
            />
          </div>

          <div>
            <label class="block text-zinc-400 mb-1 font-mono font-medium">Email Address</label>
            <input
              type="email"
              id="email-input"
              required
              placeholder="you@example.com"
              class="w-full px-3.5 py-2.5 bg-zinc-950 border border-zinc-800 rounded-xl text-zinc-200 focus:outline-none focus:border-emerald-500 transition-colors"
            />
          </div>

          <div>
            <label class="block text-zinc-400 mb-1 font-mono font-medium">Category</label>
            <select
              id="category-input"
              class="w-full px-3.5 py-2.5 bg-zinc-950 border border-zinc-800 rounded-xl text-zinc-300 focus:outline-none focus:border-emerald-500 transition-colors"
            >
              <option value="general">General Inquiry / Feedback</option>
              <option value="bug">Terminal Simulation Bug Report</option>
              <option value="tutorial">Tutorial / Command Request</option>
              <option value="editorial">Editorial / Content Correction</option>
            </select>
          </div>

          <div>
            <label class="block text-zinc-400 mb-1 font-mono font-medium">Message / Details</label>
            <textarea
              id="message-input"
              required
              rows="4"
              placeholder="Describe your question, bug report, or suggestion in detail..."
              class="w-full px-3.5 py-2.5 bg-zinc-950 border border-zinc-800 rounded-xl text-zinc-200 focus:outline-none focus:border-emerald-500 transition-colors"
            ></textarea>
          </div>

          <button
            type="submit"
            id="submit-btn"
            class="w-full py-3 bg-emerald-500 hover:bg-emerald-400 text-zinc-950 font-bold rounded-xl transition-colors font-mono cursor-pointer shadow-lg shadow-emerald-950/40"
          >
            Submit Message
          </button>

          <div id="form-feedback" class="hidden p-3.5 rounded-xl text-xs font-mono"></div>
        </form>
      </div>
    </div>
  </div>

  <script>
    const form = document.getElementById('contact-form') as HTMLFormElement | null;
    const feedback = document.getElementById('form-feedback');
    const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement | null;

    if (form && feedback && submitBtn) {
      form.addEventListener('submit', (e) => {
        e.preventDefault();
        submitBtn.disabled = true;
        submitBtn.innerText = 'Transmitting...';

        setTimeout(() => {
          feedback.className = 'p-3.5 rounded-xl text-xs font-mono bg-emerald-950/80 border border-emerald-800 text-emerald-300';
          feedback.innerHTML = '✓ Thank you! Your feedback has been received. Our team will review and reply within 24–48 hours.';
          feedback.classList.remove('hidden');
          form.reset();
          submitBtn.disabled = false;
          submitBtn.innerText = 'Submit Another Message';
        }, 800);
      });
    }
  </script>
</BaseLayout>
