---
import BaseLayout from '../layouts/BaseLayout.astro';
import { COMMANDS_LIST } from './commands/index.astro';
import { TUTORIALS_LIST } from './tutorials/index.astro';
import { CHALLENGES_LIST } from './challenges/index.astro';
import { LOCALES } from '../i18n/translations';
---

<BaseLayout
  title="HTML Sitemap — Online Linux Terminal"
  description="HTML Directory Sitemap listing all pages, tutorials, command manuals, and localized versions on OnlineLinuxTerminal.com."
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10 text-zinc-300">
    <div class="space-y-3">
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-100 font-sans">
        HTML Directory Sitemap
      </h1>
      <p class="text-xs sm:text-sm text-zinc-400">
        Complete map of all routes, tutorial modules, command manuals, and language translations on Online Linux Terminal.
      </p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Main Core Pages -->
      <div class="space-y-3 p-5 bg-zinc-900/60 border border-zinc-800 rounded-xl">
        <h2 class="font-bold text-emerald-400 font-mono text-sm uppercase tracking-wider">Main Workspace & Pages</h2>
        <ul class="space-y-2 text-xs">
          <li><a href="/" class="hover:text-emerald-400 transition-colors">Home — Online Linux Terminal</a></li>
          <li><a href="/terminal/" class="hover:text-emerald-400 transition-colors">Terminal Workspace ($)</a></li>
          <li><a href="/commands/" class="hover:text-emerald-400 transition-colors">Linux Commands Directory</a></li>
          <li><a href="/tutorials/" class="hover:text-emerald-400 transition-colors">Interactive Tutorials Hub</a></li>
          <li><a href="/challenges/" class="hover:text-emerald-400 transition-colors">Hands-on Scenario Challenges</a></li>
          <li><a href="/about/" class="hover:text-emerald-400 transition-colors">About Us & EEAT</a></li>
          <li><a href="/contact/" class="hover:text-emerald-400 transition-colors">Contact & Support</a></li>
          <li><a href="/privacy/" class="hover:text-emerald-400 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms/" class="hover:text-emerald-400 transition-colors">Terms of Service</a></li>
        </ul>
      </div>

      <!-- Command Manual Pages -->
      <div class="space-y-3 p-5 bg-zinc-900/60 border border-zinc-800 rounded-xl">
        <h2 class="font-bold text-emerald-400 font-mono text-sm uppercase tracking-wider">Command Manuals</h2>
        <ul class="grid grid-cols-2 gap-1 text-xs font-mono">
          {COMMANDS_LIST.map((cmd) => (
            <li>
              <a href={`/commands/${cmd.name}/`} class="hover:text-emerald-400 transition-colors">
                man {cmd.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Tutorials, Challenges & i18n Locales -->
      <div class="space-y-6">
        <div class="space-y-3 p-5 bg-zinc-900/60 border border-zinc-800 rounded-xl">
          <h2 class="font-bold text-emerald-400 font-mono text-sm uppercase tracking-wider">Tutorial Lessons</h2>
          <ul class="space-y-2 text-xs">
            {TUTORIALS_LIST.map((t) => (
              <li>
                <a href={`/tutorials/${t.slug}/`} class="hover:text-emerald-400 transition-colors">
                  {t.title}
                </a>
              </li>
            ))}
          </ul>
        </div>

        <div class="space-y-3 p-5 bg-zinc-900/60 border border-zinc-800 rounded-xl">
          <h2 class="font-bold text-emerald-400 font-mono text-sm uppercase tracking-wider">Language Translations</h2>
          <ul class="grid grid-cols-2 gap-2 text-xs">
            {LOCALES.map((l) => (
              <li>
                <a href={l.code === 'en' ? '/' : `/${l.code}/`} class="hover:text-emerald-400 transition-colors flex items-center space-x-1.5">
                  <span>{l.flag}</span>
                  <span>{l.name}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>
