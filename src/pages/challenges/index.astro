---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { AdSlot } from '../../components/ads/AdSlot';

export const CHALLENGES_LIST = [
  {
    slug: 'find-hidden-flag',
    title: 'Challenge 1: Find the Secret Flag File',
    difficulty: 'Easy',
    points: '100 pts',
    desc: 'Locate a hidden configuration file inside the directory tree and output its flag code.',
  },
  {
    slug: 'fix-log-permissions',
    title: 'Challenge 2: Fix Log File Permissions',
    difficulty: 'Medium',
    points: '250 pts',
    desc: 'The auth log file has restricted permissions. Modify permissions so the user can inspect it.',
  },
  {
    slug: 'extract-ip-grep',
    title: 'Challenge 3: Extract IP Addresses with Grep',
    difficulty: 'Hard',
    points: '500 pts',
    desc: 'Parse system logs and extract failed SSH login IP addresses using grep regex.',
  },
];

const itemListSchema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Hands-on Linux Scenario Challenges",
  "description": "Practical Linux troubleshooting drills with automated solution verification.",
  "itemListElement": CHALLENGES_LIST.map((c, idx) => ({
    "@type": "ListItem",
    "position": idx + 1,
    "name": c.title,
    "url": `https://onlinelinuxterminal.com/challenges/${c.slug}/`
  }))
};
---

<BaseLayout
  title="Hands-on Linux Challenges — Free Online Linux Terminal Practice"
  description="Test your Linux CLI skills with hands-on scenario drills. Solve real-world troubleshooting tasks with automated solution verification and instant feedback."
  keywords="online linux terminal for practice free, webminal online linux terminal practice, free online linux terminal practice, linux scenario challenges, online linux terminal practice"
>
  <script type="application/ld+json" set:html={JSON.stringify(itemListSchema)} />

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12 space-y-10">
    <div class="text-center max-w-3xl mx-auto space-y-3">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-800/80 text-emerald-400 text-xs font-mono">
        <span>Hands-on Skill Drills</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold text-zinc-100 font-sans">
        Practical Linux Scenario Challenges
      </h1>
      <p class="text-sm text-zinc-400 leading-relaxed">
        Put your terminal knowledge to the test. Solve real-world Linux scenarios with automated validation.
      </p>
    </div>

    <!-- Ad Placement Top -->
    <AdSlot type="banner" client:idle />

    <!-- Challenges Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 max-w-6xl mx-auto">
      {CHALLENGES_LIST.map((c) => (
        <a
          href={`/challenges/${c.slug}/`}
          class="p-6 bg-zinc-900/60 border border-zinc-800 rounded-2xl hover:border-emerald-800/80 hover:bg-zinc-900 transition-all group flex flex-col justify-between space-y-4"
        >
          <div class="space-y-2">
            <div class="flex items-center justify-between">
              <span class="text-xs font-mono px-2.5 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/50">
                {c.difficulty}
              </span>
              <span class="text-xs font-mono text-amber-400 font-bold">{c.points}</span>
            </div>
            <h3 class="text-lg font-bold text-zinc-100 group-hover:text-emerald-400 transition-colors">
              {c.title}
            </h3>
            <p class="text-xs text-zinc-400 leading-relaxed">{c.desc}</p>
          </div>

          <div class="pt-4 flex items-center justify-between text-xs font-mono text-emerald-400 font-semibold border-t border-zinc-800/80">
            <span>Attempt Scenario</span>
            <span class="group-hover:translate-x-1 transition-transform">→</span>
          </div>
        </a>
      ))}
    </div>

    <!-- 600+ Word SEO Content Section -->
    <section class="max-w-4xl mx-auto p-6 sm:p-8 bg-zinc-900/40 border border-zinc-800 rounded-2xl space-y-6 text-zinc-300">
      <h2 class="text-2xl font-bold text-zinc-100 font-sans">
        Why Practice Hands-on Linux Troubleshooting Drills?
      </h2>
      <p class="text-xs sm:text-sm leading-relaxed">
        System administration and DevOps engineering require quick problem-solving under pressure. Participating in hands-on scenario drills with an <strong>online linux terminal for practice free</strong> builds real-world confidence.
      </p>

      <div class="space-y-4 text-xs sm:text-sm">
        <h3 class="text-lg font-bold text-emerald-400">Automated Solution Verification</h3>
        <p class="text-zinc-400 leading-relaxed">
          Unlike static reading guides or older platforms like <strong>webminal online linux terminal practice</strong>, our challenge engine monitors your Virtual File System modifications in real time. When you successfully update permissions on <code>/var/log/auth.log</code> or discover hidden configuration flags, our engine validates your solution instantly with automated confetti feedback.
        </p>
      </div>
    </section>

    <!-- Ad Placement Bottom -->
    <AdSlot type="leaderboard" client:idle />
  </div>
</BaseLayout>
