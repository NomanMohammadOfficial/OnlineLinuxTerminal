---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { ChallengeRunner } from '../../components/terminal/ChallengeRunner';

export function getStaticPaths() {
  const scenarios = [
    {
      slug: 'find-hidden-flag',
      title: 'Challenge 1: Find the Secret Flag File',
      difficulty: 'Easy',
      points: '100 pts',
      mission: 'A hidden system configuration file is stored inside the /etc/ directory tree. Your task is to inspect /etc/ files using cat or grep to uncover the secret key.',
      hint: 'Run "ls /etc" to see files in /etc, then read "os-release" or "hostname".',
    },
    {
      slug: 'fix-log-permissions',
      title: 'Challenge 2: Fix Restricted Log File Permissions',
      difficulty: 'Medium',
      points: '250 pts',
      mission: 'The file /var/log/auth.log has restricted mode permissions. Change its permissions to 755 using chmod so all users can read and inspect it.',
      hint: 'Run "chmod 755 /var/log/auth.log" and verify with "ls -l /var/log/auth.log".',
    },
    {
      slug: 'extract-ip-grep',
      title: 'Challenge 3: Extract IP Addresses with Grep',
      difficulty: 'Hard',
      points: '500 pts',
      mission: 'Inspect /var/log/syslog and /var/log/auth.log to extract all occurrences of IP addresses matching 192.168 or 10.0.',
      hint: 'Use "grep -i -n 192.168 /var/log/auth.log".',
    },
    {
      slug: 'cleanup-temp-logs',
      title: 'Challenge 4: Clean Up Temporary Workspace Logs',
      difficulty: 'Easy',
      points: '200 pts',
      mission: 'The /tmp directory requires maintenance. Create or inspect the directory, or run directory cleanup commands using rm.',
      hint: 'Run "ls /tmp" and test file maintenance commands like "touch /tmp/cleaned.log".',
    },
    {
      slug: 'diagnose-high-cpu',
      title: 'Challenge 5: Diagnose System Resource Metrics',
      difficulty: 'Medium',
      points: '300 pts',
      mission: 'Inspect system resource health. Execute process monitoring commands to snapshot active processes and memory allocations.',
      hint: 'Run "ps aux" or "top" or "free -h" to inspect resource consumption.',
    },
    {
      slug: 'create-system-backup',
      title: 'Challenge 6: Create Compressed Backup Tarball',
      difficulty: 'Hard',
      points: '400 pts',
      mission: 'Bundle directory files into a compressed tarball archive using tar with gzip compression flags.',
      hint: 'Run "tar -czvf backup.tar.gz /home/user/projects".',
    },
  ];

  return scenarios.map((s) => ({
    params: { scenario: s.slug },
    props: { data: s },
  }));
}

const { data } = Astro.props;

const howToSchema = {
  "@context": "https://schema.org",
  "@type": "HowTo",
  "name": data.title,
  "description": data.mission,
  "step": [
    {
      "@type": "HowToStep",
      "position": 1,
      "name": "Mission Briefing",
      "text": data.mission
    },
    {
      "@type": "HowToStep",
      "position": 2,
      "name": "Execute Solution in Terminal",
      "text": data.hint
    }
  ]
};
---

<BaseLayout
  title={`${data.title} — Online Linux Challenge`}
  description={`Hands-on Linux scenario drill: ${data.title}. Solve live in browser terminal with instant automated solution verification.`}
  keywords={`${data.title} linux challenge, online linux terminal with root access, free online linux terminal practice, online linux terminal simulator`}
>
  <script type="application/ld+json" set:html={JSON.stringify(howToSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-10 space-y-8">
    <div class="space-y-2">
      <div class="flex items-center space-x-3">
        <a href="/challenges/" class="text-xs font-mono text-emerald-400 hover:underline">← All Challenges</a>
        <span class="text-zinc-600">•</span>
        <span class="text-xs font-mono px-2 py-0.5 rounded bg-emerald-950 text-emerald-400 border border-emerald-800/50">
          {data.difficulty}
        </span>
        <span class="text-xs font-mono text-amber-400 font-bold">{data.points}</span>
      </div>
      <h1 class="text-3xl font-extrabold text-zinc-100 font-sans">{data.title}</h1>
    </div>

    <!-- Challenge Interactive Runner Island -->
    <ChallengeRunner
      client:load
      scenarioSlug={data.slug}
      title={data.title}
      points={data.points}
      mission={data.mission}
      hint={data.hint}
    />

    <!-- Bottom Navigation Links -->
    <div class="p-4 bg-zinc-900/60 border border-zinc-800 rounded-2xl flex items-center justify-between text-xs font-mono">
      <a href="/challenges/" class="text-zinc-400 hover:text-emerald-400 transition-colors">
        ← Back to All Challenges
      </a>
      <a href="/tutorials/" class="text-emerald-400 hover:underline">
        Explore Guided Tutorials →
      </a>
    </div>
  </div>
</BaseLayout>
