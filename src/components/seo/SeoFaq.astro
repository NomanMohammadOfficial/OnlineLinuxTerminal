---
import { TRANSLATIONS, type SupportedLocale } from '../../i18n/translations';

export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  faqs?: FaqItem[];
  title?: string;
  subtitle?: string;
  lang?: SupportedLocale;
}

const {
  lang = 'en',
  faqs,
  title,
  subtitle
} = Astro.props;

const t = TRANSLATIONS[lang] || TRANSLATIONS.en;

const activeFaqs: FaqItem[] = faqs || t.faqs;
const activeTitle = title || t.faqHeaderTitle;
const activeSubtitle = subtitle || t.faqHeaderSub;

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": activeFaqs.map((f) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": f.answer
    }
  }))
};
---

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<section class="py-12 bg-zinc-950/60 border-t border-zinc-800/80">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 space-y-8">
    <div class="text-center space-y-3">
      <div class="inline-flex items-center space-x-2 px-3 py-1 rounded-full bg-emerald-950/80 border border-emerald-800/80 text-emerald-400 text-xs font-mono">
        <span>SEO & Help Center</span>
      </div>
      <h2 class="text-2xl sm:text-3xl font-extrabold text-zinc-100 font-sans tracking-tight">
        {activeTitle}
      </h2>
      <p class="text-xs sm:text-sm text-zinc-400 max-w-xl mx-auto">
        {activeSubtitle}
      </p>
    </div>

    <!-- Semantic Accordion List -->
    <div class="space-y-4">
      {activeFaqs.map((faq, idx) => (
        <details class="group bg-zinc-900/80 border border-zinc-800/80 hover:border-emerald-800/60 rounded-2xl overflow-hidden transition-all duration-200 shadow-md">
          <summary class="flex items-center justify-between p-5 text-sm sm:text-base font-bold text-zinc-100 cursor-pointer select-none group-open:text-emerald-400 transition-colors list-none">
            <span class="flex items-center space-x-3">
              <span class="text-emerald-400 font-mono text-xs font-semibold px-2 py-0.5 rounded bg-zinc-800 border border-zinc-700">Q{idx + 1}</span>
              <span>{faq.question}</span>
            </span>
            <span class="ml-4 flex-shrink-0 text-zinc-400 group-open:rotate-180 transition-transform duration-200">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
              </svg>
            </span>
          </summary>
          <div class="px-5 pb-5 pt-1 text-xs sm:text-sm text-zinc-300 leading-relaxed border-t border-zinc-800/40">
            {faq.answer}
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
